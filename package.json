{
  "name": "algorithm-viz-standalone",
  "version": "1.0.0",
  "private": true,
  "description": "Algorithm animation visualization desktop app powered by Tauri",
  "type": "module",
  "scripts": {
    "dev": "node scripts/clean-port.js && vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc -b --noEmit",
    "typecheck:watch": "tsc -b --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:standalone": "node scripts/export-standalone.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/js-yaml": "^4.0.9",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "js-yaml": "^5.3.0",
    "three": "^0.185.1"
  }
}
